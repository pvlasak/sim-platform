# backend/.env

# MongoDB
MONGODB_USER=admin
MONGODB_PASSWORD=password
MONGODB_URL=mongodb://admin:password@mongodb:27017
MONGODB_DB=simflow

# Git — absolute path to your local git clone
# This folder must already exist (git clone done manually once)
# SSH key must be configured on your machine and added to GitLab
APP_DIR=/home/app/
GIT_REPO_NAME=model-repository
GIT_REPO_PATH=/work/proj/github/model-repository
GIT_REMOTE_URL=https://gitlab.com/pvlasak-group/model-repository.git
GIT_BRANCH=main
GIT_USER_NAME=simflow
GIT_USER_EMAIL=simflow@example.com
''h/model-reposito